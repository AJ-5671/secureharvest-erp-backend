# Copy this file to .env and fill in your own values.

PORT=4000

# Paste your MongoDB Atlas connection string here (see README for how to get it).
# Replace <password> with your actual database user password.
MONGODB_URI=

# Same contract details as your middleware/frontend.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x7216fA8b3EA1cFb1967c8FdD3865E64C8B366751

# Needed ONLY for the orders "accept" endpoint, which writes a new batch
# on-chain (createBatch). Same throwaway wallet key you've used elsewhere.
# Leave blank if you only want read-only endpoints (inventory, batch-status) to work.
PRIVATE_KEY=
